{
  "manifest_version": 3,
  "name": "Brisqal for Chrome",
  "short_name": "Brisqal",
  "version": "0.0.0",
  "description": "Your AI helper in the browser. Brisqal reads pages, clicks, types and fills in forms for you, and asks before anything risky.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Brisqal",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Brisqal"
    },
    "stop-task": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Stop Brisqal's current task"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
