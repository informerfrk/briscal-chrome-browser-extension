{
  "name": "brisqal-chrome",
  "productName": "Brisqal for Chrome",
  "version": "1.1.1",
  "description": "Brisqal for Chrome: an AI agent in the side panel that does tasks in your browser. It reads pages, clicks, types and fills in forms, and asks before anything risky.",
  "author": "Brisqal",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node out/test/core.test.js",
    "test:e2e": "node esbuild.mjs --tests && xvfb-run -a -s '-screen 0 1440x900x24' node test/e2e.mjs",
    "package": "node esbuild.mjs --production && node scripts/package.mjs",
    "test:smoke": "xvfb-run -a node test/smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^20.19.43",
    "dompurify": "3.2",
    "esbuild": "^0.24.2",
    "marked": "^15.0.12",
    "puppeteer-core": "^24.43.1",
    "typescript": "5.6"
  }
}
